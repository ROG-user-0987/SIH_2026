# Backend
# - "true": random-ish demo mode (no models needed)
# - "false": real analysis. You MUST supply either REMOTE_INFERENCE_URL
#   (recommended, heavy model lives on a GPU box) or a local MODEL_DIR with
#   an ONNX checkpoint.
MOCK_MODE=false
MODEL_DIR=
# Remote inference service (see backend/remote_server/README.md for deployment)
REMOTE_INFERENCE_URL=
# Set true to download/use Silero VAD at runtime (adds a download); false = energy VAD
USE_SILERO_VAD=false
PORT=8000
ALLOWED_ORIGINS=*

# Frontend (set in Vercel / .env.local)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/analyze
NEXT_PUBLIC_API_URL=http://localhost:8000
